<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>MediaToolkit.NET: one API over the native media stacks. This package pulls in every backend and selects the right one for the current operating system. Install a single backend package instead if you only need one.</Description>
    <PackageTags>media;facade;cross-platform;ffmpeg;mpv;mediafoundation;wasapi;v4l2;alsa;avfoundation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MediaToolkitNet.Core/MediaToolkitNet.Core.csproj" />
    <ProjectReference Include="../MediaToolkitNet.FFmpeg/MediaToolkitNet.FFmpeg.csproj" />
    <ProjectReference Include="../MediaToolkitNet.Mpv/MediaToolkitNet.Mpv.csproj" />
    <ProjectReference Include="../MediaToolkitNet.Windows/MediaToolkitNet.Windows.csproj" />
    <ProjectReference Include="../MediaToolkitNet.Linux/MediaToolkitNet.Linux.csproj" />
    <ProjectReference Include="../MediaToolkitNet.MacOS/MediaToolkitNet.MacOS.csproj" />
  </ItemGroup>

</Project>
