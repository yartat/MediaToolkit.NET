<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>GStreamer backend for MediaToolkit.NET: build a pipeline from a gst-launch description, drive its state, read its bus, and take decoded video and audio frames out of an appsink, probe files with GstDiscoverer and transcode them through a pipeline built from the request. The portable counterpart of the DirectShow filter graph on Linux.</Description>
    <PackageTags>gstreamer;linux;pipeline;appsink;capture;audio;video;transcoding</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MediaToolkitNet.Abstractions/MediaToolkitNet.Abstractions.csproj" />
    <ProjectReference Include="../MediaToolkitNet.Interop/MediaToolkitNet.Interop.csproj" />
  </ItemGroup>

</Project>
